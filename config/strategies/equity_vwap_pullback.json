{
  "name": "VWAP_Pullback_Equity",
  "description": "VWAP pullback mean-reversion strategy for NSE equity with RSI confirmation",
  "enabled": true,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "10:00:00",
    "end_time": "14:30:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "VWAP_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 42,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 62,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    },
    {
      "name": "VWAP_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 58,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 38,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 0.6,
    "target_pct": 1.5,
    "time_based_exit": "14:30:00",
    "max_holding_minutes": 60
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 3,
    "max_trades_per_day": 3
  },
  "params": {
    "strategy_type": "mean_reversion"
  }
}
