    {
      "name": "Gap_Up_Fade",
      "signal": "PE",
      "conditions": [
        {
          "indicator": "Gap_Pct",
          "comparison": ">",
          "value": 0.2,
          "timeframe": "1d"
        },
        {
          "indicator": "Gap_Pct",
          "comparison": "<",
          "value": 0.5,
          "timeframe": "1d"
        },
        {
          "indicator": "First_5min_Close",
          "comparison": "<",
          "against": "Open",
          "timeframe": "1min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 60,
          "timeframe": "1min",
          "parameters": {
            "length": 14
          }
        }
      ]
    },
    {
      "name": "Gap_Down_Fade",
      "signal": "CE",
      "conditions": [
        {
          "indicator": "Gap_Pct",
          "comparison": "<",
          "value": -0.2,
          "timeframe": "1d"
        },
        {
          "indicator": "Gap_Pct",
          "comparison": ">",
          "value": -0.5,
          "timeframe": "1d"
        },
        {
          "indicator": "First_5min_Close",
          "comparison": ">",
          "against": "Open",
          "timeframe": "1min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 40,
          "timeframe": "1min",
          "parameters": {
            "length": 14
          }
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 20,
    "target_pct": 24,
    "time_based_exit": "10:30:00",
    "max_holding_minutes": 70
