{
  "name": "Supertrend_EMA_RSI_BankNifty",
  "version": "5.0.0",
  "description": "Supertrend with EMA crossover and RSI — BankNifty ATM options with trailing SL",
  "enabled": false,
  "underlying": {
    "instrument_key": "NSE_INDEX|Nifty Bank",
    "symbol": "BANKNIFTY",
    "segment": "NSE_FO"
  },
  "trading_hours": {
    "start_time": "09:30:00",
    "end_time": "14:30:00",
    "timezone": "Asia/Kolkata"
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "Supertrend_Bullish",
      "signal": "BUY",
      "priority": 2,
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "Supertrend",
          "parameters": { "period": 10, "multiplier": 3 }
        },
        {
          "indicator": "EMA_9",
          "comparison": ">",
          "against": "EMA_21",
          "parameters": {}
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 50,
          "parameters": { "period": 14 }
        },
        {
          "indicator": "ADX",
          "comparison": ">",
          "value": 20,
          "parameters": { "period": 14 }
        }
      ]
    },
    {
      "name": "Supertrend_Bearish",
      "signal": "SELL",
      "priority": 2,
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "Supertrend",
          "parameters": { "period": 10, "multiplier": 3 }
        },
        {
          "indicator": "EMA_9",
          "comparison": "<",
          "against": "EMA_21",
          "parameters": {}
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 50,
          "parameters": { "period": 14 }
        },
        {
          "indicator": "ADX",
          "comparison": ">",
          "value": 20,
          "parameters": { "period": 14 }
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 40,
    "target_pct": 75,
    "trailing_stop_loss": {
      "enabled": false,
      "activation_pct": 18,
      "trail_pct": 10
    },
    "time_based_exit": "14:30:00",
    "max_holding_minutes": 120
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 2,
    "max_trades_per_day": 3
  }
}
