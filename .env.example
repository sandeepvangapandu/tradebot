UPSTOX_USERNAME=
UPSTOX_PASSWORD=
UPSTOX_PIN_CODE=
UPSTOX_TOTP_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1/callback

# Dhan credentials (get from https://dhanhq.co/ → Developer Portal)
DHAN_CLIENT_ID=your_10_digit_account_id
DHAN_ACCESS_TOKEN=your_jwt_access_token

# Broker selection: "dhan" or "upstox"
ACTIVE_BROKER=dhan

TRADING_MODE=paper
DEFAULT_EXCHANGE=NSE
MAX_DAILY_LOSS=500000
MAX_OPEN_POSITIONS=5
MAX_POSITION_SIZE_PCT=20
CAPITAL=100000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=sqlite:///data/trading_bot.db
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# Supabase + Postgres storage (Phase 0)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
LOCAL_DB_URL=postgresql://USER@localhost:5432/tradebot
ENV=dev
