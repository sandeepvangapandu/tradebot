{
  "name": "ORB_Breakout_Equity",
  "description": "Opening Range Breakout — first-hour only. EMA_9>EMA_21 trend alignment, RSI >60/<40, volume >1.5x avg. Cuts false breakouts vs prior 09:30-11:30 wide window.",
  "enabled": true,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "09:30:00",
    "end_time": "10:30:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min",
    "orb": "15min"
  },
  "entry_sets": [
    {
      "name": "ORB_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "ORB_HIGH",
          "timeframe": "15min",
          "lookback": 0
        },
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": ">",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 60,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 78,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.5,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    },
    {
      "name": "ORB_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "ORB_LOW",
          "timeframe": "15min",
          "lookback": 0
        },
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": "<",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 40,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 22,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.5,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 0.8,
    "target_pct": 2.5,
    "time_based_exit": "11:30:00",
    "max_holding_minutes": 60
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 1,
    "max_trades_per_day": 1
  },
  "params": {
    "orb_minutes": 15,
    "strategy_type": "breakout"
  }
}
