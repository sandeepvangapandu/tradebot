  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 2
  },
  "risk_management": {
    "max_open_positions": 3,
    "max_trades_per_day": 5
  },
  "params": {
    "min_gap_pct": 0.2,
    "max_gap_pct": 0.5,
    "entry_window_minutes": 15,
    "first_candle_minutes": 5,
    "gap_fill_target_pct": 80
