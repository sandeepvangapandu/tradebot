{
  "name": "Pro_Trader_Max_Profit_Config",
  "description": "Professional trader configuration - maximize profits without arbitrary trade limits",
  "mode": "aggressive_profit_maximization",

  "trading_philosophy": {
    "approach": "Take every high-quality signal that meets criteria",
    "trade_limit": "unlimited",
    "selection_criteria": "Risk-adjusted opportunity quality",
    "position_sizing": "Dynamic based on conviction and capital",
    "goal": "Maximum daily profit within risk constraints"
  },

  "risk_management": {
    "max_daily_loss_pct": 5.0,
    "max_daily_loss_paisa": 500000,
    "max_position_size_pct": 30,
    "max_capital_deployment_pct": 95,
    "max_open_positions": 10,
    "max_trades_per_day": 999,
    "max_correlated_positions": 3,
    "consecutive_loss_pause": 5,
    "pause_minutes": 15,
    "circuit_breaker_loss_pct": 8.0,
    "daily_profit_target_pct": 10.0
  },

  "position_sizing_rules": {
    "base_method": "kelly_criterion",
    "min_quantity": 1,
    "max_quantity_per_trade": 10,
    "scaling": {
      "high_conviction_score_90plus": 2.0,
      "medium_conviction_score_75plus": 1.5,
      "normal_conviction": 1.0,
      "after_win_streak_3plus": 1.3,
      "after_loss": 0.8,
      "high_volatility_regime": 0.7
    }
  },

  "signal_filters": {
    "min_research_score": 60,
    "min_confluence_level": "WEAK",
    "require_volume_confirmation": true,
    "max_slippage_pct": 0.1,
    "time_of_day": {
      "morning_session": "09:20-11:30",
      "afternoon_session": "13:30-15:15",
      "avoid_lunch": true
    }
  },

  "profit_optimization": {
    "trail_winnings": true,
    "scale_winners": true,
    "cut_losers_quickly": true,
    "re_enter_after_stop": true,
    "max_re_entries": 2,
    "compound_profits": true,
    "reinvest_daily_pnl": false
  },

  "strategy_priorities": {
    "ORB_VWAP": {"weight": 1.5, "max_concurrent": 2},
    "Supertrend_EMA_RSI": {"weight": 1.3, "max_concurrent": 2},
    "PDH_PDL_Breakout": {"weight": 1.4, "max_concurrent": 2},
    "CPR_VWAP_Bounce": {"weight": 1.2, "max_concurrent": 2},
    "RSI_Divergence": {"weight": 1.1, "max_concurrent": 2},
    "Gap_Fade": {"weight": 1.0, "max_concurrent": 1},
    "Expiry_Straddle": {"weight": 1.3, "max_concurrent": 1, "only_on_expiry": true}
  },

  "aggressive_features": {
    "pyramiding_winners": true,
    "add_to_winning_position": {
      "enabled": true,
      "trigger_profit_pct": 30,
      "additional_size_pct": 50,
      "max_additions": 2
    },
    "reduce_losers": {
      "enabled": true,
      "reduce_at_loss_pct": 15,
      "reduction_pct": 50
    },
    "opportunity_aggression": {
      "high_quality_setup_multiplier": 2.0,
      "strong_trend_multiplier": 1.5,
      "weak_setup_reducer": 0.5
    }
  }
}
