{
  "name": "MACD_Crossover_BankNifty",
  "version": "5.0.0",
  "description": "MACD crossover with VWAP and RSI \u2014 BankNifty ATM options with trailing SL",
  "enabled": true,
  "underlying": {
    "instrument_key": "NSE_INDEX|Nifty Bank",
    "symbol": "BANKNIFTY",
    "segment": "NSE_FO"
  },
  "trading_hours": {
    "start_time": "09:45:00",
    "end_time": "13:00:00",
    "timezone": "Asia/Kolkata"
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "MACD_Bullish_Cross",
      "signal": "BUY",
      "priority": 1,
      "conditions": [
        {
          "indicator": "MACD",
          "comparison": "crosses_above",
          "against": "MACD_Signal",
          "parameters": {
            "fast": 12,
            "slow": 26,
            "signal": 9
          }
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 50,
          "parameters": {
            "period": 14
          }
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 70,
          "parameters": {
            "period": 14
          }
        },
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "VWAP",
          "parameters": {}
        }
      ]
    },
    {
      "name": "MACD_Bearish_Cross",
      "signal": "SELL",
      "priority": 1,
      "conditions": [
        {
          "indicator": "MACD",
          "comparison": "crosses_below",
          "against": "MACD_Signal",
          "parameters": {
            "fast": 12,
            "slow": 26,
            "signal": 9
          }
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 55,
          "parameters": {
            "period": 14
          }
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 30,
          "parameters": {
            "period": 14
          }
        },
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "VWAP",
          "parameters": {}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 45,
    "target_pct": 80,
    "trailing_stop_loss": {
      "enabled": false,
      "activation_pct": 18,
      "trail_pct": 10
    },
    "time_based_exit": "15:00:00",
    "max_holding_minutes": 120
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 2,
    "max_trades_per_day": 3
  },
  "params": {
    "strategy_type": "trend_following"
  }
}