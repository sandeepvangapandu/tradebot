{
  "name": "Supertrend_Breakout_Equity",
  "description": "Supertrend trend-following strategy for NSE equity with RSI directional filter",
  "enabled": true,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "09:30:00",
    "end_time": "14:30:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "ST_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "Supertrend",
          "timeframe": "5min",
          "parameters": {"period": 7, "multiplier": 3.0}
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 50,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    },
    {
      "name": "ST_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "Supertrend",
          "timeframe": "5min",
          "parameters": {"period": 7, "multiplier": 3.0}
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 50,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 1.5,
    "target_pct": 3.0,
    "time_based_exit": "14:30:00",
    "max_holding_minutes": 180
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 2,
    "max_trades_per_day": 3,
    "max_position_size_pct": 50
  },
  "params": {
    "strategy_type": "trend_following"
  }
}
