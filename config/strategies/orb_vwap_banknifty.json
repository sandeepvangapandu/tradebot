        },
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.2,
          "timeframe": "5min",
          "parameters": {
            "relative_to": "avg_20"
          }
        }
      ]
    },
    {
      "name": "ORB_Short",
      "signal": "PE",
      "conditions": [
        {
          "indicator": "ORB_BREAKDOWN",
          "comparison": "crosses_below",
          "against": "ORB_LOW",
          "timeframe": "15min",
          "lookback": 0
        },
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.2,
          "timeframe": "5min",
          "parameters": {
            "relative_to": "avg_20"
          }
        }
      ]
    }
  ],
  "exit_rules": {
