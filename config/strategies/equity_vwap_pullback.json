{
  "name": "VWAP_Pullback_Equity",
  "description": "VWAP pullback mean-reversion with EMA trend direction filter. Only trade VWAP crosses aligned with EMA_9/21 trend. RSI 40-55 for longs (in-trend pullback), 45-60 for shorts. Volume >1.2x. Target raised 1.5%->2.0% (3.3:1 R:R).",
  "enabled": false,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "10:30:00",
    "end_time": "13:30:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "VWAP_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": ">",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 40,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 55,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.2,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    },
    {
      "name": "VWAP_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": "<",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 60,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 45,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.2,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 0.6,
    "target_pct": 2.0,
    "time_based_exit": "13:30:00",
    "max_holding_minutes": 90
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 50
  },
  "risk_management": {
    "max_open_positions": 2,
    "max_trades_per_day": 4,
    "max_position_size_pct": 50
  },
  "params": {
    "strategy_type": "mean_reversion"
  }
}
