{
  "name": "ORB_Breakout_Equity",
  "description": "Opening Range Breakout strategy for NSE equity with VWAP and RSI confluence",
  "enabled": true,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "09:30:00",
    "end_time": "11:30:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min",
    "orb": "15min"
  },
  "entry_sets": [
    {
      "name": "ORB_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "ORB_HIGH",
          "timeframe": "15min",
          "lookback": 0
        },
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 55,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    },
    {
      "name": "ORB_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "ORB_LOW",
          "timeframe": "15min",
          "lookback": 0
        },
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 45,
          "timeframe": "5min",
          "parameters": {"period": 14}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 0.8,
    "target_pct": 2.5,
    "time_based_exit": "13:00:00",
    "max_holding_minutes": 90
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 15
  },
  "risk_management": {
    "max_open_positions": 2,
    "max_trades_per_day": 2
  },
  "params": {
    "orb_minutes": 15,
    "strategy_type": "breakout"
  }
}
