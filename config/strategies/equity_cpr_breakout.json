{
  "name": "CPR_Breakout_Equity",
  "description": "Central Pivot Range (CPR) breakout on 5-min bars. Long when price crosses above TC (top central pivot) with EMA_9>EMA_21, price>VWAP, RSI>52, Volume>1.3x. Short when price crosses below BC (bottom central pivot) with opposite filters. CPR auto-computed from prior day OHLC. Very popular NSE intraday approach. SL 0.8% / target 1.8% (2.25:1 R:R, breakeven at 31% WR).",
  "enabled": false,
  "segment": "NSE_EQ",
  "trading_hours": {
    "start_time": "09:30:00",
    "end_time": "14:00:00",
    "timezone": "Asia/Kolkata",
    "days": [0, 1, 2, 3, 4]
  },
  "timeframes": {
    "primary": "5min"
  },
  "entry_sets": [
    {
      "name": "CPR_Long",
      "signal": "BUY",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_above",
          "against": "CPR_TC",
          "timeframe": "5min"
        },
        {
          "indicator": "Spot_Price",
          "comparison": ">",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": ">",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": ">",
          "value": 50,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.1,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    },
    {
      "name": "CPR_Short",
      "signal": "SELL",
      "conditions": [
        {
          "indicator": "Spot_Price",
          "comparison": "crosses_below",
          "against": "CPR_BC",
          "timeframe": "5min"
        },
        {
          "indicator": "Spot_Price",
          "comparison": "<",
          "against": "VWAP",
          "timeframe": "5min"
        },
        {
          "indicator": "EMA_9",
          "comparison": "<",
          "against": "EMA_21",
          "timeframe": "5min"
        },
        {
          "indicator": "RSI",
          "comparison": "<",
          "value": 50,
          "timeframe": "5min",
          "parameters": {"period": 14}
        },
        {
          "indicator": "Volume",
          "comparison": ">",
          "value": 1.1,
          "timeframe": "5min",
          "parameters": {"type": "average_multiplier", "period": 20}
        }
      ]
    }
  ],
  "exit_rules": {
    "stop_loss_pct": 0.8,
    "target_pct": 1.8,
    "time_based_exit": "13:30:00",
    "max_holding_minutes": 90
  },
  "position_sizing": {
    "method": "fixed_quantity",
    "quantity": 50
  },
  "risk_management": {
    "max_open_positions": 1,
    "max_trades_per_day": 2,
    "max_position_size_pct": 50
  },
  "params": {
    "strategy_type": "breakout"
  }
}
